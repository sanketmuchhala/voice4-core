#!/bin/sh
# Install once per clone (applies to all worktrees):  git config core.hooksPath scripts/hooks
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 1. Never commit env files (except the template).
if echo "$staged" | grep -E '(^|/)\.env(\..+)?$' | grep -vqE '\.env\.example$'; then
  echo "pre-commit: refusing to commit a .env file" >&2
  exit 1
fi

# 2. Secret scan on added lines.
pattern='(sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{30,}|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
if git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' | grep -qE "$pattern"; then
  echo "pre-commit: possible secret in staged changes:" >&2
  git diff --cached -U0 --diff-filter=ACM | grep -E '^\+[^+]' | grep -E "$pattern" | cut -c1-80 >&2
  exit 1
fi

# 3. Lint + typecheck when Python changed.
if echo "$staged" | grep -qE '\.py$|pyproject\.toml$'; then
  uv run ruff check .
  uv run mypy
fi

# 4. Contracts drift check.
if echo "$staged" | grep -q '^packages/contracts/'; then
  uv run python -m bolchaal_contracts.export --check
fi
